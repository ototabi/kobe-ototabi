<!-- 🏎️ ページを開いた瞬間に、指定の動画まで「ふんわり自動スクロール」させるJavaScript -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.location.hash) {
            const targetId = window.location.hash; 
            const targetElement = document.querySelector(targetId);
            
            if (targetElement) {
                // ページが完全に読み込まれるまで0.4秒だけ優しく待機させます
                setTimeout(function () {
                    targetElement.scrollIntoView({
                        behavior: "smooth", 
                        block: "center"     
                    });
                    
                    // スクロール完了後に臨時65系統などを緑色のカッコいい光で包む演出
                    setTimeout(function() {
                        targetElement.style.boxShadow = "0 0 30px rgba(40, 167, 69, 0.4)";
                        targetElement.style.border = "1px solid rgba(40, 167, 69, 0.3)";
                    }, 800);
                }, 400);
            }
        }
    });
</script>
