@page
@model OtherModel
@{
    ViewData["Title"] = "車内放送アーカイブ";
}

<style>
    .container, main, div.container {
        max-width: 100% !important;
        padding-left: 0px !important;
        padding-right: 0px !important;
        margin: 0px !important;
    }


    .custom-container {
        max-width: 1300px !important;
        width: 92% !important;          /* 👈 画面の端っこにパツパツにならないようにします */
        margin-left: auto !important;   /* 👈 左右を自動にすることで、完全に真ん中寄せになります */
        margin-right: auto !important;  /* 👈 左右を自動にすることで、完全に真ん中寄せになります */
        padding-left: 24px !important;
        padding-right: 24px !important;
        text-align: left !important;
    }

    .hover-lift {
        transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s ease !important;
    }
    .hover-lift:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .fade-in-right-delay {
        opacity: 0;
        transform: translateX(50px);
        transition: opacity 1.3s cubic-bezier(0.16, 1, 0.3, 1), transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .fade-in-right-delay.show {
        opacity: 1;
        transform: translateX(0);
    }

    nav.navbar {
        position: absolute !important;
        z-index: 99999 !important; 
        width: 100%;
    }
</style>

<!-- 👇 画像エリア：左右の隙間を無くして画面目一杯に広げました 👇 -->
<div style="position: relative; width: 100%; height: 320px; overflow: hidden; border-radius: 0px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-top: 0px; margin-bottom: 40px;">
    <!-- 1層目：神戸市バスの画像（左右目一杯） -->
    <img src="/images/East02.JPG" alt="駅放送ヘッダー" style="width: 100%; height: 120%; object-fit: cover; display: block;" />
    <!-- 2層目：薄黒いフィルター -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.45);"></div>
    <!-- 3層目：中央配置の文字エリア -->
    <div style="position: absolute; top: 50%; left: 5%; transform: translateY(-50%); text-align: left; width: 90%;">
        <h1 style="color: white; font-family: 'Hiragino Kaku Gothic ProN', sans-serif; font-weight: bold; font-size: 2.2rem; text-shadow: 2px 2px 8px rgba(0,0,0,0.6); margin: 0;">
            🚉 駅放送アーカイブ
        </h1>
        <p style="color: #e0e0e0; font-size: 1rem; margin-top: 10px; text-shadow: 1px 1px 4px rgba(0,0,0,0.6); margin-bottom: 0;">
            主に鉄道の駅放送をあつめたページです。
        </p>
    </div>
</div>
<style>
    .container, main, div.container {
        max-width: 100% !important;
        padding-left: 0px !important;
        padding-right: 0px !important;
        margin: 0px !important;
    }

    .custom-container {
