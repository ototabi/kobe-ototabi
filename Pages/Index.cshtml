                        onmouseover="this.style.backgroundColor='#dc3545'; this.style.color='#ffffff';" 
                        onmouseout="this.style.backgroundColor='transparent'; this.style.color='#dc3545';"
                        onclick="location.href='/Other'">
                    その他を聴く →
                </button>
            </div>
        </div>

    </div>
</div>

<div style="height: 100px;"></div>

<!-- 👇 スクロールしてふわっと出すJavaScript 👇 -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const trainBox = document.getElementById("scrollContent");
        const stationBox = document.getElementById("stationScrollContent");
        const otherBox = document.getElementById("otherScrollContent");
        
        function checkScroll() {
            const triggerBottom = window.innerHeight * 0.85;
            
            if (trainBox && trainBox.getBoundingClientRect().top < triggerBottom) {
                trainBox.classList.add("show");
            }
            if (stationBox && stationBox.getBoundingClientRect().top < triggerBottom) {
                stationBox.classList.add("show");
            }
            if (otherBox && otherBox.getBoundingClientRect().top < triggerBottom) {
                otherBox.classList.add("show");
            }
        }
        
        window.addEventListener("scroll", checkScroll);
        checkScroll();
    });
</script>

