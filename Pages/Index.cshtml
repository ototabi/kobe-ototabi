                    車内放送を聴く →
                </button>
            </div>
        </div>

    </div>
</div>
<!-- 🚉 駅放送コーナー（右からふわっと出現・薄緑背景） -->
<style>
    /* 最初は透明で、右側に35pxズレて隠れている状態 */
    .fade-in-right {
        opacity: 0;
        transform: translateX(35px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    /* スクロールしてこのクラス（合図）がついたら、元の位置に戻りながらクッキリ表示 */
    .fade-in-right.show {
        opacity: 1;
        transform: translateX(0);
    }
</style>

