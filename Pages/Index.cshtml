<!-- 横からふわっと出る角丸四角形の箱（カード型デザイン） -->
<style>
    .fade-in-left {
        opacity: 0;
        transform: translateX(-35px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .fade-in-left.show {
        opacity: 1;
        transform: translateX(0);
    }
</style>

<div id="scrollContent" class="container my-5 p-4 fade-in-left" style="max-width: 800px; background-color: #ceecfa; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-align: left;">
    <div class="row align-items-center">
        
        <div class="col-md-5 mb-3 mb-md-0">
            <img src="/images/Hankyu04.jpg" alt="車内放送イメージ" style="width: 100%; height: 200px; object-fit: cover; border-radius: 15px;" />
        </div>
        
        <!-- 💡 ps-md-4 の後ろに「pe-md-5」を追加して、右側にもゆったりした空白を作りました！ -->
        <div class="col-md-7 ps-md-4 pe-md-5">
            <h2 style="font-family: 'Hiragino Kaku Gothic ProN', sans-serif; font-weight: bold; color: #007bff; margin-bottom: 15px;">
                  車内放送
            </h2>
            <p style="color: #555; line-height: 1.7; font-size: 1rem; margin-bottom: 20px;">
                鉄道やバスの車内で流れる、車内放送を録音しました。「全区間」にこだわっており、最初から最後まで聞き通せます。ぜひお楽しみください。
            </p>
            
            <div class="mt-3">
                <button class="btn btn-outline-primary px-4" style="border-radius: 20px; font-weight: bold; border-color: #007bff; color: #007bff; transition: all 0.3s ease;" 
                        onmouseover="this.style.backgroundColor='#007bff'; this.style.color='#ffffff';" 
                        onmouseout="this.style.backgroundColor='transparent'; this.style.color='#007bff';"
