                        onmouseout="this.style.backgroundColor='transparent'; this.style.color='#28a745';"
                        onclick="location.href='/Station'">

                    駅放送を聴く →
                </button>
            </div>
        </div>

    </div>
</div>

<!-- 🚩 その他コーナー（左からふわっと出現・薄赤背景） -->
<div id="otherScrollContent" class="container my-5 p-4 fade-in-left" style="max-width: 800px; background-color: #fdf2f2; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-align: left;">
