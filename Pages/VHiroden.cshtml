@page
@model VHirodenModel
@{
    ViewData["Title"] = "広島電鉄 - 車内放送";
}

<style>
    .container, main, div.container {
        max-width: 100% !important;
        padding-left: 0px !important;
        padding-right: 0px !important;
        margin: 0px !important;
    }

    .custom-container {
        max-width: 1300px !important;
        width: 95% !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding-left: 24px !important;
        padding-right: 24px !important;
        text-align: left !important;
    }

    .bus-card {
        background-color: #569a2a75 !important;
        border-radius: 20px !important;            
        box-shadow: 0 4px 20px rgba(0,0,0,0.06) !important; 
        padding: 30px !important;                  
        margin-bottom: 30px !important;            
        transition: all 0.5s ease;
    }

    .bus-card .video-space {
        margin: 15px !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    nav.navbar {
        position: absolute !important;
        z-index: 99999 !important; 
        width: 100%;
    }
</style>

<div style="position: relative; width: 100%; height: 600px; overflow: hidden; border-radius: 0px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-top: 0px; margin-bottom: 40px;">
    <img src="images/Hiroden02.jpg" alt="広島電鉄" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.45);"></div>
    
    <div style="position: absolute; top: 50%; left: 5%; transform: translateY(-50%); text-align: left; width: 90%;">
        <span class="badge bg-primary mb-2" style="font-size: 0.9rem; border-radius: 10px; padding: 6px 12px;">車内放送</span>
        <h1 style="color: white; font-family: 'Hiragino Kaku Gothic ProN', sans-serif; font-weight: bold; font-size: 2.2rem; text-shadow: 2px 2px 8px rgba(0,0,0,0.6); margin: 0; margin-top: 5px;">
            広島電鉄 車内放送アーカイブ
        </h1>
    </div>
</div>

<div class="custom-container mt-5 py-4">

    <div id="busLa" class="bus-card">
        <h3 class="font-weight-bold mb-4" style="color: #2c701b;">循環線　外回り 本通→本通（全区間）</h3>
        
        <div class="row align-items-start">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="video-space bg-dark p-2">
                    <div class="ratio ratio-16x9">
                        <iframe src="https://youtube.com/embed/wLTSKQ6tHvY" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 ps-lg-4 pt-3">
                <p style="color: #333333; line-height: 1.8; font-size: 1.05rem; margin-bottom: 20px;">
                    広電では、去年の夏に広島駅を通らない循環線が開業しました。車両は、昔ながらの単車が走っています。車内放送では、基本放送はボイスピークの車内放送、広告放送は従来の方が担当しています。胡町の放送など、特徴的な広告放送が印象に残ります。
                </p>
                <div style="color: #555555; font-size: 0.95rem; line-height: 1.6; border-top: 1px dashed #ccc; padding-top: 15px;">
                    <strong>収録機器：</strong> AudioTechnica AT2040USB<br />
                </div>
            </div>
        </div>
    </div>

</div> 

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.location.hash) {
            const targetId = window.location.hash; 
            const targetElement = document.querySelector(targetId);
            
            if (targetElement) {
                setTimeout(function () {
                    targetElement.scrollIntoView({
                        behavior: "smooth", 
                        block: "center"     
                    });
                    
                    setTimeout(function() {
                        targetElement.style.boxShadow = "0 0 30px rgba(40, 167, 69, 0.4)";
                        targetElement.style.border = "1px solid rgba(40, 167, 69, 0.3)";
                    }, 800);
                }, 400);
            }
        }
    });
</script>
