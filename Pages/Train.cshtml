                    <div class="mt-3">
                        <button class="btn btn-primary px-4 shadow-sm" style="border-radius: 20px; font-weight: bold;" onclick="location.href='/VKobeBus#bus65a'">
                            再生する ▶
                        </button>
                    </div>
                </div>
            </div>
        </div>

